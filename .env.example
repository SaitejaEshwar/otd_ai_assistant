# Local configuration; copy to .env. No API keys required.
OTD_HOST=127.0.0.1
OTD_PORT=8000
OTD_TIMEZONE=America/Chicago
OTD_DATABASE_PATH=data/tasks.sqlite3
# Disable only for testing or maintenance; task editing remains available.
OTD_REMINDERS_ENABLED=true

# Optional offline AI server, running separately on this computer.
OTD_AI_BACKEND=llama_cpp
OTD_AI_URL=http://127.0.0.1:8081
OTD_AI_MODEL=otd-qwen
OTD_AI_TIMEOUT_SECONDS=90
